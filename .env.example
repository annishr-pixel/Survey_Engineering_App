# ---- Database (Neon Postgres) ----
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (unpooled) connection string used for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ---- Auth.js ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app (required in production).
AUTH_URL="http://localhost:3000"

# ---- Notion ----
# Internal integration secret. The integration MUST be shared with BOTH databases.
NOTION_TOKEN="ntn_xxx"
# Database IDs (NOT the collection:// data-source URIs). Resolve from the Notion UI/API.
NOTION_ENQUIRIES_DB_ID="dfabb33d-da97-484a-9e11-24ea5025d7e6"
NOTION_CUSTOMER_DETAILS_DB_ID="383ee11a-d705-8035-a870-fb1797dde67f"
# The Status select option pushed back on submit. MUST already exist on the Enquiries DB.
NOTION_READY_STATUS_NAME="Ready for Quotation"

# ---- Vercel Blob (photo storage) ----
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ---- Email (sales notification on survey submit) ----
# Optional: leave SMTP_HOST or SALES_NOTIFICATION_EMAIL blank to disable.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465, "false" for 587/STARTTLS
SMTP_USER="apikey-or-username"
SMTP_PASS="smtp-password"
MAIL_FROM="Treadlight Surveys <no-reply@elmechltd.co.uk>"
SALES_NOTIFICATION_EMAIL="sales@elmechltd.co.uk"   # comma-separated for multiple
APP_URL="http://localhost:3000"

# ---- Initial estimation PDFs ----
# Local folder holding the generated initial-estimation PDFs. Files are matched
# to a job by name prefix, e.g. "TL1906-01_Customer_Initial_Estimation.pdf".
INITIAL_ESTIMATION_FILE_PATH="C:\\path\\to\\Invoice Initial Estimation Agent"
